{
  "framework": "vite",
  "buildCommand": "cd ../.. && npm run build:personal",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/blog-cms",
      "destination": "/write",
      "permanent": false
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    }
  ],
  "trailingSlash": false
}
