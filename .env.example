VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Cloudflare
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_GLOBAL_API_KEY="your-cloudflare-global-api-key"
CLOUDFLARE_EMAIL="your-cloudflare-email"
CLOUDFLARE_ZONE_ID="your-zone-id"
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_ORIGIN_CA_KEY="your-origin-ca-key"

# Netlify (build/deploy)
NETLIFY_SITE_HOSTNAME="your-site.netlify.app"
# Optional: for CLI/API access (env vars, deploys). Create at https://app.netlify.com → Applications → Personal access tokens
# NETLIFY_AUTH_TOKEN="nfp_..."
